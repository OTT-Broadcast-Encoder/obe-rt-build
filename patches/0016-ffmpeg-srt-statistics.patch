+/* Only the I/O owner updates/reads this snapshot. No socket handles or secrets
+ * cross the public AVOption boundary, and bstats(clear=0) preserves counters. */
+static void libsrt_obe_stats(SRTContext *s)
+{
+    int64_t now = av_gettime_relative();
+    SRT_TRACEBSTATS p;
+    char *snapshot;
+    if (now - s->obe_stats_at < 1000000)
+        return;
+    s->obe_stats_at = now;
+    if (srt_bstats(s->fd, &p, 0) < 0 || !isfinite(p.msRTT) || p.msRTT < 0 || p.msRTT > 1e9)
+        return;
+    snapshot = av_asprintf("{\"sample_us\":%"PRId64",\"rtt_us\":%"PRId64
+                          ",\"received_packets\":%"PRId64",\"received_bytes\":%"PRIu64
+                          ",\"lost_packets\":%d,\"retransmitted_packets\":%d,\"dropped_packets\":%d"
+                          ",\"buffer_bytes\":%d,\"buffer_ms\":%d,\"buffer_available_bytes\":%d,\"latency_ms\":%d}",
+                          now, (int64_t)(p.msRTT * 1000), p.pktRecvTotal, p.byteRecvTotal,
+                          p.pktRcvLossTotal, p.pktRcvRetrans, p.pktRcvDropTotal,
+                          p.byteRcvBuf, p.msRcvBuf, p.byteAvailRcvBuf, p.msRcvTsbPdDelay);
+    if (snapshot) {
+        av_freep(&s->obe_stats);
+        s->obe_stats = snapshot;
+    }
+}
+
 static int libsrt_read(URLContext *h, uint8_t *buf, int size)
 {
